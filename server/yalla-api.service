[Unit]
Description=YALLA KIDS API (accounts, subscriptions, live-talk tokens)
After=network.target

[Service]
User=yalla-api
EnvironmentFile=/etc/yalla-api.env
ExecStart=/usr/bin/node /opt/yalla-api/server/yalla-api.mjs
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yalla-api
PrivateTmp=true

[Install]
WantedBy=multi-user.target

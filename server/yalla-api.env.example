# /etc/yalla-api.env  (root:yalla-api, chmod 640). Secrets are pasted ON THE SERVER, never in chat.
# --- live talk (unchanged) ---
LIVE_TALK_ENABLED=0
ELEVENLABS_AGENT_KEY=
MIKA_AGENT_ID=agent_1301m6y3eyy6f8eveebqdyvmdfpc
GLOBAL_DAY_MIN=10          # all families together, per Israel day (test-phase guard)
PER_HOUR=4
# Per-family caps now come from the plan: 3 min per call, 3 min/day, 30 min/month (server/lib/plans.mjs).
# LEGACY_FAMILY_LOGIN=1 keeps the old per-basic-auth-login caps for callers without an account (transition only).
LEGACY_FAMILY_LOGIN=0
LOGIN_DAY_MIN=5
# --- accounts and subscriptions ---
SIGNUP_ENABLED=1
ALLOWED_ORIGINS=https://kids.152-53-64-98.sslip.io
PUBLIC_URL=https://kids.152-53-64-98.sslip.io/preview
BASE_PATH=/preview
ADMIN_PORT=8091
ADMIN_TOKEN=               # long random string: openssl rand -hex 32
# --- charging: OFF until the owner says go ---
BILLING_ENABLED=0
BILLING_PROVIDER=mock      # grow once the Grow account is open (mock = tests and the free pilot)
BILLING_WEBHOOK_SECRET=    # mock provider only
MOCK_PAY=0                 # never 1 on the live server
# --- Grow (formerly Meshulam): hosted payment page, monthly standing order, automatic invoices ---
# From the Grow dashboard / Grow onboarding. Check with: node admin.mjs selfcheck
GROW_USER_ID=              # "userId" Grow gives you for the API
GROW_PAGE_CODE_RECURRING=  # pageCode of the payment page set up as הוראת קבע (monthly, 39 ₪)
GROW_PAGE_CODE_ONETIME=    # pageCode of a regular one-time payment page (yearly, 349 ₪, no auto-renew)
GROW_WEBHOOK_KEY=          # our own random secret, never given to anyone: openssl rand -hex 24
GROW_SANDBOX=1             # 1 = Grow's test environment (no real money). Set 0 only for the paid launch.
GROW_API_BASE=             # leave empty (tests only)
# --- parent sign-in by SMS code ---
SMS_PROVIDER=mock          # mock sends nothing. Real Israeli SMS gateway added once the owner opens an account.
SMS_DAY_CAP=200            # cost guard: SMS messages per day, all families together
SMS_DEV_ECHO=0             # never 1 on the live server (returns the code in the API answer, tests only)
# --- parent sign-in by WhatsApp (free: the parent sends US the code) ---
WA_NUMBER=                 # the business WhatsApp number, e.g. 9723XXXXXXX (digits)
WA_APP_SECRET=             # Meta app secret: verifies webhook signatures (required to turn WhatsApp on)
WA_VERIFY_TOKEN=           # any long random string; paste the same in Meta's webhook setup
WA_TOKEN=                  # optional: system-user token, only for the free "connected ✅" reply
WA_PHONE_NUMBER_ID=        # optional, with WA_TOKEN
# Meta webhook: Callback URL = PUBLIC_URL + /api/whatsapp/webhook, Verify token = WA_VERIFY_TOKEN, field = messages
